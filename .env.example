# Copy this file to ".env" and fill in real values before running the app.
# Never commit your actual .env file to GitHub.

# Long random string used to sign session cookies and CSRF tokens.
# Generate one with: python -c "import os; print(os.urandom(24).hex())"
SECRET_KEY=

# Admin dashboard login. If ADMIN_PASSWORD is left blank, the app will
# generate a one-time random password and print it to the console on
# first run — check your terminal output the first time you start it.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Set to true only once you deploy behind HTTPS (e.g. with a reverse proxy).
FORCE_HTTPS=false
